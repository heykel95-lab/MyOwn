# LaTeX build outputs
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log

# Run records are evidence, not build output. The *.log rule above is for
# LaTeX, and it silently swallowed the terminal.log that
# analyse_t_mode_consistency reads to confirm a run's setup-impedance hold.
!code/python/experiments/**/terminal.log

*.lot
*.out
*.synctex.gz
*.toc

# Generated thesis PDFs in the project root
/Thesis.pdf
/Thesis*_preview.pdf

# Local editor and temporary files
.vscode/
.claude/
*.bak
*.tmp

# Scratch jobname used for warning checks
/_v.*

# Python bytecode
__pycache__/
*.pyc
